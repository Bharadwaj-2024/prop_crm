# ============================================================
# Call-Centric AI CRM — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# ---------- Exotel ----------
# Found in: https://my.exotel.com → Settings → API
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SID=your_exotel_sid_here

# ---------- Sarvam AI ----------
# Found in: https://dashboard.sarvam.ai → API Keys
SARVAM_API_KEY=your_sarvam_api_key_here

# ---------- Google Gemini ----------
# Found in: https://aistudio.google.com → API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- Groq (optional) ----------
GROQ_API_KEY=your_groq_api_key_here

# ---------- Upstash Redis ----------
# IMPORTANT: Two different URLs are used:
#
# 1. UPSTASH_REDIS_URL — ioredis-compatible rediss:// URL (for BullMQ)
#    Format: rediss://:PASSWORD@HOST.upstash.io:6379
#    Found in Upstash Console → Database → "Redis URL" (ioredis section)
#
# 2. UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN — REST API (for @upstash/redis)
#    Found in Upstash Console → Database → REST API section
#
UPSTASH_REDIS_URL="rediss://:your_upstash_password@your-db.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# ---------- Supabase ----------
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------- Cloudflare R2 (optional — for audio archival) ----------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ---------- Meta WhatsApp Cloud API ----------
# Found in: https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
